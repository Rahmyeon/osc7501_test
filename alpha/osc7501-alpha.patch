+    fn report(body: &[u8]) -> Report {
+        match Command::parse_body(body).unwrap() {
+            Command::Report(report) => report,
+            Command::Query => panic!("expected report"),
+        }
+    }
+
+    #[test]
+    fn program_status_query_and_states() {
