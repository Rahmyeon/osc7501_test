+#[cfg(test)]
+mod program_status_tests {
+    use super::*;
+    use wezterm_term::ProgramStatusRecord;
+
+    #[test]
+    fn program_status_lua_snapshot_is_a_sequence_with_optional_fields() -> mlua::Result<()> {
+        let lua = mlua::Lua::new();
+        let records = vec![
+            ProgramStatusRecord {
+                id: String::new(),
+                state: "working".to_string(),
+                kind: None,
+                progress: Some(40),
+                app: Some("cargo".to_string()),
+                title: None,
+                msg: None,
+                effective_app: Some("cargo".to_string()),
+            },
+            ProgramStatusRecord {
+                id: "build/test".to_string(),
+                state: "blocked".to_string(),
+                kind: Some("permission".to_string()),
+                progress: None,
+                app: None,
+                title: Some("Approve test access".to_string()),
+                msg: Some("Allow the integration test to continue".to_string()),
+                effective_app: Some("cargo".to_string()),
+            },
+        ];
+        // Lua configuration consumes this public data contract. Root identity,
+        // omitted fields and inherited app data must survive serde conversion.
+        lua.globals().set("records", lua.to_value(&records)?)?;
+        lua.load(
+            r#"
+            assert(#records == 2)
+            assert(records[1].id == "")
+            assert(records[1].state == "working")
+            assert(records[1].progress == 40)
+            assert(records[1].kind == nil and records[1].title == nil)
+            assert(records["build/test"] == nil)
+            assert(records[2].id == "build/test")
+            assert(records[2].state == "blocked")
+            assert(records[2].kind == "permission")
+            assert(records[2].app == nil and records[2].progress == nil)
+            assert(records[2].effective_app == "cargo")
+            assert(records[2].msg == "Allow the integration test to continue")
+            "#,
+        )
+        .exec()?;
+        lua.globals().set(
+            "empty_records",
+            lua.to_value(&Vec::<ProgramStatusRecord>::new())?,
+        )?;
+        lua.load("assert(type(empty_records) == 'table' and next(empty_records) == nil)")
+            .exec()
+    }
+}
