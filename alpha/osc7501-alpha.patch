+struct CountChanges(Arc<AtomicUsize>);
+
+impl AlertHandler for CountChanges {
+    fn alert(&mut self, _alert: Alert) {}
+
+    fn program_status_changed(&mut self) {
+        self.0.fetch_add(1, Ordering::SeqCst);
+    }
